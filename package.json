{
  "name": "comm-center",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "db:up": "docker compose up -d --wait db",
    "docker:up": "docker compose --profile app up -d --build --wait",
    "docker:down": "docker compose --profile app down",
    "clean": "rm -rf node_modules .turbo apps/*/node_modules apps/*/dist apps/api/.venv apps/api/.pytest_cache apps/api/.ruff_cache"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
