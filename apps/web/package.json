{
  "name": "@comm-center/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "gen:api": "cd ../api && uv run python -m app.export_openapi > ../web/src/api/openapi.json && cd ../web && openapi-typescript src/api/openapi.json --default-non-nullable false -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3"
  }
}
