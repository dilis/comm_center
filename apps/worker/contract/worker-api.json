{
  "components": {
    "schemas": {
      "ClaimOut": {
        "properties": {
          "lease_seconds": {
            "title": "Lease Seconds",
            "type": "integer"
          },
          "message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClaimedMessage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "message",
          "lease_seconds"
        ],
        "title": "ClaimOut",
        "type": "object"
      },
      "ClaimRequest": {
        "properties": {
          "device_id": {
            "title": "Device Id",
            "type": "integer"
          },
          "wait_seconds": {
            "default": 0,
            "minimum": 0.0,
            "title": "Wait Seconds",
            "type": "number"
          }
        },
        "required": [
          "device_id"
        ],
        "title": "ClaimRequest",
        "type": "object"
      },
      "ClaimedMessage": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "phone_number": {
            "title": "Phone Number",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phone_number",
          "content"
        ],
        "title": "ClaimedMessage",
        "type": "object"
      },
      "DeviceStatusIn": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "status": {
            "enum": [
              "online",
              "offline",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "DeviceStatusIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InboundIn": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "device_id": {
            "title": "Device Id",
            "type": "integer"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "ref": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Ref",
            "type": "string"
          },
          "sender": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Sender",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "ref",
          "sender",
          "content",
          "received_at"
        ],
        "title": "InboundIn",
        "type": "object"
      },
      "InboundOut": {
        "properties": {
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          },
          "stored": {
            "title": "Stored",
            "type": "boolean"
          }
        },
        "required": [
          "stored",
          "duplicate",
          "message_id"
        ],
        "title": "InboundOut",
        "type": "object"
      },
      "LeaseOut": {
        "properties": {
          "lease_seconds": {
            "title": "Lease Seconds",
            "type": "integer"
          }
        },
        "required": [
          "lease_seconds"
        ],
        "title": "LeaseOut",
        "type": "object"
      },
      "ResultIn": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "status": {
            "enum": [
              "sent",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ResultIn",
        "type": "object"
      },
      "SessionDevice": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "phone_number": {
            "title": "Phone Number",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone_number"
        ],
        "title": "SessionDevice",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/SessionDevice"
            },
            "title": "Devices",
            "type": "array"
          },
          "protocol_version": {
            "title": "Protocol Version",
            "type": "integer"
          }
        },
        "required": [
          "protocol_version",
          "devices"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "instance_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Instance Id",
            "type": "string"
          },
          "protocol_version": {
            "title": "Protocol Version",
            "type": "integer"
          },
          "version": {
            "maxLength": 64,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "protocol_version",
          "instance_id"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkerToken": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "WorkerToken",
        "type": "object"
      },
      "WorkerTokenRequest": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "name",
          "secret"
        ],
        "title": "WorkerTokenRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Comm Center worker API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/worker/claim": {
      "post": {
        "description": "Hand the next queued message to the worker, leased to it for ``lease_seconds`` (extend or\nreport before then). Waits up to ``wait_seconds`` for one to arrive.",
        "operationId": "claim_worker_claim_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Claim",
        "tags": [
          "worker"
        ]
      }
    },
    "/worker/devices/{device_id}/status": {
      "post": {
        "description": "Health of a device. An error is kept as history after the device recovers.",
        "operationId": "device_status_worker_devices__device_id__status_post",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "title": "Device Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceStatusIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Device Status",
        "tags": [
          "worker"
        ]
      }
    },
    "/worker/inbound": {
      "post": {
        "description": "Store a received SMS, finding or creating the sender's contact. Answers 200 only after the\ncommit, so the worker may then forget the message on the device.",
        "operationId": "inbound_worker_inbound_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Inbound",
        "tags": [
          "worker"
        ]
      }
    },
    "/worker/messages/{message_id}/extend": {
      "post": {
        "operationId": "extend_lease_worker_messages__message_id__extend_post",
        "parameters": [
          {
            "in": "path",
            "name": "message_id",
            "required": true,
            "schema": {
              "title": "Message Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Extend Lease",
        "tags": [
          "worker"
        ]
      }
    },
    "/worker/messages/{message_id}/result": {
      "post": {
        "description": "What happened to a message the worker holds. ``sent`` means the device accepted it.",
        "operationId": "report_result_worker_messages__message_id__result_post",
        "parameters": [
          {
            "in": "path",
            "name": "message_id",
            "required": true,
            "schema": {
              "title": "Message Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Report Result",
        "tags": [
          "worker"
        ]
      }
    },
    "/worker/session": {
      "post": {
        "description": "The handshake and heartbeat: records what the worker is, and tells it which device it serves.",
        "operationId": "session_worker_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Session",
        "tags": [
          "worker"
        ]
      }
    },
    "/worker/token": {
      "post": {
        "operationId": "token_worker_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkerToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Token",
        "tags": [
          "worker"
        ]
      }
    }
  }
}
