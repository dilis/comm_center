# Copy to .env. docker compose reads it automatically; the API reads DATABASE_URL when it runs
# natively. Use URL-safe passwords (letters and digits), because DATABASE_URL embeds them.

# --- MySQL (docker compose creates the database and user from these on first start) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=comm_center
MYSQL_USER=comm_center
MYSQL_PASSWORD=comm_center

# --- Host ports for docker compose ---
DB_PORT=3307
API_PORT=8000
WEB_PORT=8080

# --- API running natively (outside compose): must point at the same database ---
DATABASE_URL=mysql+pymysql://comm_center:comm_center@127.0.0.1:3307/comm_center

# --- Authentication ---
# Signs access and refresh tokens (compose passes it to the API too). Anything beyond local
# development needs a long random value, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Derives each Android phone's webhook signing key. Set a long random value outside development
# (`openssl rand -hex 32`); changing it means re-entering the key in every phone.
WEBHOOK_SECRET=dev-only-webhook-secret-change-me-dev-only
# Optional: ACCESS_TOKEN_TTL_SECONDS=900, REFRESH_TOKEN_TTL_SECONDS=604800, DEFAULT_PHONE_REGION=PH

# --- Logging and login rate limiting ---
# LOG_LEVEL applies to the API and the worker (DEBUG, INFO, WARNING, ERROR or CRITICAL).
LOG_LEVEL=INFO
# Optional: LOGIN_MAX_FAILURES=5 (failed sign-ins per username), LOGIN_MAX_FAILURES_PER_IP=20 and
# LOGIN_LOCKOUT_SECONDS=900 (the window; also how long a lockout lasts at most),
# PASSWORD_MAX_FAILURES=5 (wrong current passwords per user when changing a password) and
# REFRESH_MAX_FAILURES_PER_IP=30 (invalid refresh tokens per address)

# --- Worker (separate process; see docs/DEPLOYMENT.md) ---
# The worker has no database access: it signs in to the API as the agent of the device it serves,
# `gsm-<device name>`. Compose creates the device and its secret from these (the `worker-setup`
# service). Outside development set a long random secret (`openssl rand -hex 32`, at least 16
# characters). A worker started by hand sets WORKER_NAME=gsm-<device name> instead.
WORKER_DEVICE=fake
WORKER_DEVICE_PHONE=+639170000000
WORKER_SECRET=dev-only-worker-secret-change-me
# What kind of device the worker runs and how to reach it is the worker's own business (the API
# does not know): WORKER_PROVIDER=fake (default) or android. For android also set
# WORKER_ANDROID_BASE_URL (e.g. http://192.168.1.50:8080), WORKER_ANDROID_USERNAME and
# WORKER_ANDROID_PASSWORD, preferably in the worker's own environment rather than here.
# Where the worker finds the API. Compose sets http://api:8000; native workers default to
# http://127.0.0.1:8000. WORKER_API_URL=http://127.0.0.1:8000
# Optional: WORKER_POLL_INTERVAL_SECONDS=2 (idle wait, and how often the worker checks in with the
# API), WORKER_LEASE_SECONDS=120 and WORKER_LONG_POLL_SECONDS=20 (API settings: how long a
# worker may hold a message before it is failed, and the longest a claim waits),
# WORKER_TOKEN_TTL_SECONDS=900 (API),, WORKER_MAX_ATTEMPTS=3 (sends before a
# message is marked failed), WORKER_BACKOFF_BASE_SECONDS=2 (doubles each retry),
# WORKER_HEARTBEAT_FILE=/tmp/comm-center-worker.heartbeat (touched every cycle, for healthchecks),
# WORKER_ANDROID_TIMEOUT_SECONDS=15.
# The fake provider imitates a modem, one message at a time: WORKER_FAKE_SEND_DELAY_SECONDS=2 plus
# up to WORKER_FAKE_SEND_JITTER_SECONDS=1 per message (set both to 0 for instant sends)
