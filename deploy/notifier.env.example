# Notifier container (used with: docker run --env-file deploy/notifier.env ... comm-center-notifier)
# Sends the push notifications the API queued. Run exactly one. It needs the database (the same one
# as the API; a user limited to the two push tables is enough) and outbound internet access.
DATABASE_URL=mysql+pymysql://comm_center:change-me-app@cc-db:3306/comm_center
# From `python -m app.cli vapid-keys` (apps/api). The same public key also goes to the API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: PUSH_MAX_ATTEMPTS=6, PUSH_RETRY_BASE_SECONDS=30, NOTIFIER_POLL_SECONDS=1,
# NOTIFIER_LEASE_SECONDS=60, LOG_LEVEL=INFO
