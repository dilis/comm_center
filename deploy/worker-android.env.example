# Copy to deploy/worker-android.env (gitignored) and fill in. Used by docker-compose.android.yml.

# The phone's Local Server, as shown in the SMS Gateway app (Local Server on, port 8080 by default).
# The container must be able to reach this address (same LAN; not localhost, which is the container).
WORKER_ANDROID_BASE_URL=http://192.168.1.50:8080
WORKER_ANDROID_USERNAME=
WORKER_ANDROID_PASSWORD=

# Optional: how long to wait for the phone to answer.
# WORKER_ANDROID_TIMEOUT_SECONDS=15
#
# The device name, its number, the worker secret and the send interval are not set here: put
# WORKER_DEVICE, WORKER_DEVICE_PHONE, WORKER_SECRET and WORKER_SEND_INTERVAL_SECONDS in the root .env
# (compose reads them from there).
