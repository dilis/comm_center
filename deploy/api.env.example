# API container (used with: docker run --env-file deploy/api.env ... comm-center-api)
# On a user-defined Docker network the database host is the db container's name.
# Keep the user, password and database equal to deploy/db.env, and the password URL-safe.
DATABASE_URL=mysql+pymysql://comm_center:change-me-app@cc-db:3306/comm_center
